---
import Layout from '../../layouts/Layout.astro';
import AudioExtractorWorkspace from '../../components/AudioExtractorWorkspace';
import FeaturesSection from '../../components/FeaturesSection.astro';
import HowItWorksSection from '../../components/HowItWorksSection.astro';
import FormatMatrixSection from '../../components/FormatMatrixSection.astro';
import FaqSection from '../../components/FaqSection.astro';
import { useTranslations } from '../../i18n/utils';
import { type SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  const nonDefaultLocales: SupportedLanguage[] = ['es', 'pt', 'de', 'fr', 'ja'];
  return nonDefaultLocales.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
---

<Layout lang={lang}>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden border-b border-slate-200/80 dark:border-slate-800/80">
    <!-- Background Ambient Glow -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-brand-teal/15 via-brand-ochre/10 to-brand-coral/10 blur-3xl pointer-events-none -z-10 rounded-full"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-teal/10 dark:bg-brand-teal/20 text-brand-teal dark:text-brand-teal-light text-xs font-bold uppercase tracking-wider border border-brand-teal/20 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-brand-teal animate-pulse"></span>
        {t('hero.badge')}
      </div>

      <!-- Main Title -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.1] max-w-4xl mx-auto">
        {t('hero.title')}
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg md:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        {t('hero.subtitle')}
      </p>

      <!-- Trust Badges -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2 text-xs font-semibold text-slate-600 dark:text-slate-400">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
          <svg class="w-3.5 h-3.5 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          {t('hero.privacyPill')}
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700">
          <svg class="w-3.5 h-3.5 text-brand-ochre-dark dark:text-brand-ochre" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          {t('hero.speedPill')}
        </span>
      </div>

      <!-- React Interactive Workspace Island -->
      <div class="pt-8 sm:pt-10">
        <AudioExtractorWorkspace client:load lang={lang} />
      </div>
    </div>
  </section>

  <!-- Static Informational & Content Sections -->
  <FeaturesSection lang={lang} />
  <HowItWorksSection lang={lang} />
  <FormatMatrixSection lang={lang} />
  <FaqSection lang={lang} />
</Layout>
