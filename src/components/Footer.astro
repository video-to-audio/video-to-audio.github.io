---
import { useTranslations } from '../i18n/utils';
import { languages, type SupportedLanguage } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 dark:border-slate-800/80 bg-slate-50 dark:bg-slate-950 py-12 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand & Info -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-brand-teal to-brand-ochre flex items-center justify-center shadow-sm">
            <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
            </svg>
          </div>
          <span class="font-bold text-lg tracking-tight text-slate-900 dark:text-white">
            {t('nav.brand')}
          </span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md leading-relaxed">
          {t('footer.description')}
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-teal/10 dark:bg-brand-teal/20 text-brand-teal dark:text-brand-teal-light text-xs font-semibold border border-brand-teal/20">
          <span class="w-2 h-2 rounded-full bg-brand-teal animate-pulse"></span>
          {t('footer.privacyNote')}
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          Navigation
        </h3>
        <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li><a href="#features" class="hover:text-brand-teal dark:hover:text-brand-teal-light transition-colors">{t('nav.features')}</a></li>
          <li><a href="#how-it-works" class="hover:text-brand-teal dark:hover:text-brand-teal-light transition-colors">{t('nav.howItWorks')}</a></li>
          <li><a href="#formats" class="hover:text-brand-teal dark:hover:text-brand-teal-light transition-colors">{t('nav.formats')}</a></li>
          <li><a href="#faq" class="hover:text-brand-teal dark:hover:text-brand-teal-light transition-colors">{t('nav.faq')}</a></li>
          <li><a href="https://ko-fi.com/kishara" target="_blank" rel="noopener noreferrer" class="text-amber-600 dark:text-amber-400 hover:underline font-semibold flex items-center gap-1.5">☕ {t('nav.support')}</a></li>
        </ul>
      </div>

      <!-- Col 3: Languages -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          Languages
        </h3>
        <ul class="grid grid-cols-2 gap-2 text-sm text-slate-600 dark:text-slate-400">
          {Object.entries(languages).map(([code, data]) => (
            <li>
              <a
                href={getLocalizedPath(code as SupportedLanguage, Astro.url.pathname)}
                hreflang={code}
                class={`hover:text-brand-teal dark:hover:text-brand-teal-light transition-colors flex items-center gap-1.5 ${
                  code === lang ? 'font-semibold text-brand-teal dark:text-brand-teal-light' : ''
                }`}
              >
                <span>{data.flag}</span>
                <span>{data.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-500">
      <p>© {currentYear} {t('nav.brand')}. {t('footer.allRights')}</p>
      <p>{t('footer.disclaimer')}</p>
    </div>
  </div>
</footer>
