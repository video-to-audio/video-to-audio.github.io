---
import { useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const formats = [
  {
    format: 'MP3',
    ext: '.mp3',
    type: 'Lossy (MPEG-1 Audio Layer III)',
    bitrate: 'Up to 320 kbps',
    bestKey: 'matrix.mp3Best',
    badgeClass: 'bg-brand-teal/10 text-brand-teal border-brand-teal/20'
  },
  {
    format: 'WAV',
    ext: '.wav',
    type: 'Lossless (Uncompressed PCM 16-bit)',
    bitrate: '1411 kbps (Bit-for-bit)',
    bestKey: 'matrix.wavBest',
    badgeClass: 'bg-brand-ochre/15 text-brand-ochre-dark dark:text-brand-ochre border-brand-ochre/30'
  },
  {
    format: 'AAC',
    ext: '.aac',
    type: 'Lossy (Advanced Audio Coding)',
    bitrate: 'Up to 320 kbps',
    bestKey: 'matrix.aacBest',
    badgeClass: 'bg-brand-coral/10 text-brand-coral border-brand-coral/20'
  },
  {
    format: 'M4A',
    ext: '.m4a',
    type: 'Lossy (MPEG-4 Audio Container)',
    bitrate: 'Up to 320 kbps',
    bestKey: 'matrix.m4aBest',
    badgeClass: 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border-indigo-500/20'
  }
];
---

<section id="formats" class="py-20 border-b border-slate-200/80 dark:border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-coral/10 text-brand-coral border border-brand-coral/20">
        {t('matrix.badge')}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t('matrix.title')}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {t('matrix.subtitle')}
      </p>
    </div>

    <!-- Desktop Table View -->
    <div class="hidden lg:block overflow-hidden rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-sm bg-white dark:bg-slate-900">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-800/50 text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            <th class="py-4 px-6">{t('matrix.colFormat')}</th>
            <th class="py-4 px-6">{t('matrix.colExtension')}</th>
            <th class="py-4 px-6">{t('matrix.colType')}</th>
            <th class="py-4 px-6">{t('matrix.colBitrate')}</th>
            <th class="py-4 px-6">{t('matrix.colBestFor')}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80 text-sm">
          {formats.map(f => (
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
              <td class="py-4 px-6 font-bold text-slate-900 dark:text-white">
                <span class={`inline-block px-2.5 py-1 rounded-lg text-xs font-extrabold border ${f.badgeClass}`}>
                  {f.format}
                </span>
              </td>
              <td class="py-4 px-6 font-mono text-slate-600 dark:text-slate-300 font-semibold">{f.ext}</td>
              <td class="py-4 px-6 text-slate-600 dark:text-slate-400">{f.type}</td>
              <td class="py-4 px-6 text-slate-700 dark:text-slate-300 font-medium">{f.bitrate}</td>
              <td class="py-4 px-6 text-slate-600 dark:text-slate-400 leading-relaxed">{t(f.bestKey as any)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile Card View -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:hidden gap-6">
      {formats.map(f => (
        <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-sm space-y-3">
          <div class="flex items-center justify-between">
            <span class={`px-2.5 py-1 rounded-lg text-xs font-extrabold border ${f.badgeClass}`}>
              {f.format}
            </span>
            <span class="font-mono text-xs font-semibold text-slate-500">{f.ext}</span>
          </div>
          <div>
            <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">{f.type}</div>
            <div class="text-sm font-bold text-slate-900 dark:text-white mt-0.5">{f.bitrate}</div>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 pt-2 border-t border-slate-100 dark:border-slate-800 leading-relaxed">
            <strong class="text-slate-700 dark:text-slate-300 font-semibold">{t('matrix.colBestFor')}: </strong>
            {t(f.bestKey as any)}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
